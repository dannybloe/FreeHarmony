{
  // A solution file with no sources of its own, so an editor loads both worlds at once and every
  // file in this repository is claimed by exactly one of them.
  //
  // "A file no tsconfig claims is not typechecked, and it does not announce that" is a rule the
  // sibling repository paid for: a whole directory of scripts sat outside its project for months
  // and a language server gave them default options. So when a directory of TypeScript is added
  // here, it goes into one of these two in the same commit.
  "files": [],
  "references": [{ "path": "./tsconfig.node.json" }, { "path": "./tsconfig.web.json" }]
}
