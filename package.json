{
  "name": "freeharmony",
  "version": "0.0.0",
  "private": true,
  "description": "A local, offline application for configuring Logitech Harmony remotes",
  "license": "GPL-3.0-only",
  "packageManager": "pnpm@11.20.0",
  "type": "module",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "inventory": "node bin/inventory.ts",
    "typecheck:node": "tsc -p tsconfig.node.json",
    "typecheck:web": "tsc -p tsconfig.web.json",
    "typecheck": "pnpm typecheck:node && pnpm typecheck:web",
    "test": "node --test 'test/**/*.test.ts'"
  },
  "dependencies": {
    "@harmony/codec": "link:../harmony-explorations/packages/codec",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "electron": "43.4.0",
    "electron-vite": "5.0.0",
    "typescript": "5.9.3",
    "vite": "8.2.1"
  }
}
