{
  "name": "freeharmony",
  "version": "0.0.0",
  "private": true,
  "description": "A local, offline application for configuring Logitech Harmony remotes",
  "license": "GPL-3.0-only",
  "packageManager": "pnpm@11.20.0",
  "type": "module",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "inventory": "node bin/inventory.ts",
    "screenshot": "pnpm build && node bin/screenshot.ts",
    "typecheck:node": "tsc -p tsconfig.node.json",
    "typecheck:web": "tsc -p tsconfig.web.json",
    "typecheck": "pnpm typecheck:node && pnpm typecheck:web",
    "test:unit": "node --test 'test/*.test.ts'",
    "test:app": "pnpm build && node --test 'test/app/*.test.ts'",
    "test": "pnpm test:unit && pnpm test:app",
    "check": "pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@harmony/codec": "link:../harmony-explorations/packages/codec",
    "@harmony/silhouettes": "link:../harmony-explorations/packages/silhouettes",
    "@mantine/core": "9.5.1",
    "@mantine/hooks": "9.5.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "electron": "43.4.0",
    "electron-vite": "5.0.0",
    "postcss": "8.5.26",
    "postcss-preset-mantine": "1.18.0",
    "sass-embedded": "1.102.0",
    "typescript": "5.9.3",
    "vite": "8.2.1"
  }
}
